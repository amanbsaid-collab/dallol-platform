# Managed PostgreSQL connection string. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dallol?sslmode=require"

# Long random application secret (32+ bytes recommended).
AUTH_SECRET="replace-with-a-long-random-secret"

# Public HTTPS application origin in production.
NEXT_PUBLIC_APP_URL="https://your-dallol-domain.example"
